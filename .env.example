# Optional. Leave both blank to run entirely in demo mode with data stored in the browser.
# Use the Supabase anon (public) key only.
# Never put a service-role key in NEXT_PUBLIC_SUPABASE_ANON_KEY or any other NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Coach mail. Leave RESEND_API_KEY unset to use the local mail fallback, which accepts the
# message on this server and does not hand it to an outside inbox.
# COACH_MAIL_FROM must be an address on a domain the provider has verified.
RESEND_API_KEY=
COACH_MAIL_FROM=
